# SearXNG Deployment Configuration
# Copy this file to searxng.env and fill in your values

# Email for Let's Encrypt SSL certificate notifications
EMAIL="your-email@replmade.com"

# Your SSH public key (get from: cat ~/.ssh/linode_searxng.pub)
# IMPORTANT: Must be quoted!
SSH_PUBLIC_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILdEHA5B9UvZu8gF02JqnqW3flWaDE9eKLfkQKfxe9bW overlook-searxng@replmade.com"

# API token for authentication (generate with: openssl rand -hex 32)
# Leave empty to disable API authentication
API_TOKEN="a276a0f52897f633c2836e9dabee1c8284533cc80752a4fe6f066600178e02bb"

# Domain for your SearXNG instance
DOMAIN="search.replmade.com"

# Server instance name (shown in SearXNG UI)
INSTANCE_NAME="Overlook Search"
